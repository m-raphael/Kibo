# ---------------------------------------------------------------------------
# CyberPet — environment variables
# Copy this file to .env and fill in values for your environment.
# .env is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

# ---- Vite / Frontend -------------------------------------------------------

# Overrides the Vite dev server port (default: 1420, must match tauri.conf.json devUrl)
# VITE_DEV_PORT=1420

# Set to "true" to enable verbose tracker debug output in the browser console
# VITE_DEBUG_TRACKER=false

# ---- LLM provider routing --------------------------------------------------
# Which provider the mascot assignment LLM adapter uses.
# Options: anthropic | gemini | openai-compatible | openrouter | groq | together
#          huggingface | nvidia-nim | none
#
# Free options:
#   - groq          → free tier at console.groq.com (fast, open models)
#   - openrouter    → free-tier models at openrouter.ai (e.g. google/gemma-2-9b-it:free)
#   - huggingface   → free inference API at huggingface.co
#   - openai-compatible with Ollama → fully local, no key needed
#
# Paid / subscription:
#   - anthropic     → uses your ANTHROPIC_API_KEY (Claude Code Pro subscription works)
#   - gemini        → uses GEMINI_API_KEY, has generous free tier
#   - nvidia-nim    → uses NVIDIA_API_KEY (free credits available)
#   - together      → uses TOGETHER_API_KEY, has free-tier models
#   - none          → disable LLM, fall back to rule-based assignment

LLM_PROVIDER=none
LLM_MODEL=
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_MODEL=

# ---- Anthropic / Claude (Pro subscription or API key) ----------------------
# Claude Code Pro subscribers: run `claude api-key` to get your key.
# Works with claude-3-5-haiku-20241022 (cheap) or claude-sonnet-4-6 (best).
ANTHROPIC_API_KEY=

# ---- Google Gemini ----------------------------------------------------------
# Free tier available at aistudio.google.com — set LLM_PROVIDER=gemini
GEMINI_API_KEY=

# ---- OpenAI-compatible generic endpoint (Ollama / vLLM / LiteLLM) ----------
# Local Ollama example:
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama          (any non-empty string)
#   OPENAI_MODEL=qwen2.5:7b        (any model you pulled with `ollama pull`)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---- OpenRouter (free-tier cloud models) -----------------------------------
# Sign up free at openrouter.ai — many models have :free variants
# e.g. LLM_MODEL=google/gemma-2-9b-it:free
OPENROUTER_API_KEY=

# ---- Groq (fast free tier) -------------------------------------------------
# Free at console.groq.com — llama-3.1-8b-instant is a good default
GROQ_API_KEY=

# ---- Together AI ------------------------------------------------------------
TOGETHER_API_KEY=

# ---- HuggingFace Inference --------------------------------------------------
HUGGINGFACE_API_KEY=

# ---- NVIDIA NIM / NGC -------------------------------------------------------
# Free credits at build.nvidia.com — meta/llama-3.1-8b-instruct works well
NVIDIA_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_BASE=

# ---- xAI (Grok) -------------------------------------------------------------
XAI_API_KEY=

# ---- Tauri build -----------------------------------------------------------

# Code-signing identity for macOS notarisation (CI/staging builds)
# APPLE_CERTIFICATE=          # base64-encoded .p12 certificate
# APPLE_CERTIFICATE_PASSWORD= # password for the .p12
# APPLE_SIGNING_IDENTITY=     # e.g. "Developer ID Application: Acme Corp (XXXXXXXXXX)"
# APPLE_ID=                   # Apple ID email used for notarisation
# APPLE_PASSWORD=             # app-specific password for that Apple ID
# APPLE_TEAM_ID=              # Apple Developer Team ID

# ---- Face tracker (Python service) ----------------------------------------

# Camera device index passed to cv2.VideoCapture (default: 0 = built-in webcam)
# CYBERPET_CAMERA_INDEX=0

# Minimum MediaPipe face detection confidence (0.0–1.0, default: 0.5)
# CYBERPET_DETECTION_CONFIDENCE=0.5

# Minimum MediaPipe face tracking confidence (0.0–1.0, default: 0.5)
# CYBERPET_TRACKING_CONFIDENCE=0.5

# ---- Staging / CI ----------------------------------------------------------

# Target architecture for cross-compilation (e.g. aarch64-apple-darwin)
# TAURI_TARGET=

# Set by the Tauri CLI during builds; do not set manually
# TAURI_ENV=staging|production
